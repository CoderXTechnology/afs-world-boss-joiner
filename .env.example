# ── Required ─────────────────────────────────────────────────────────────
# Producers (the Roblox script) authenticate with this token (Bearer).
INGEST_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# You authenticate the admin dashboard with this token (login page).
ADMIN_TOKEN=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING

# ── Optional ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# How long a boss spotting stays "live" (seconds)
SPOT_TTL_SECONDS=90

# How long a server stays "online" without a heartbeat (seconds)
SERVER_TTL_SECONDS=120

# Maximum stored detections (oldest evicted)
MAX_SPOTS=1000

# Key database file (user keys for the finder clients)
KEY_DB_FILE=./keys.json

# ── Simulator only (npm run simulate) ────────────────────────────────────
# BASE_URL=https://afs-world-boss-joiner-production.up.railway.app
# SIM_BOSS=SeaBeast
# SIM_RARITY=world
# SIM_JOB_ID=simulated-job-0001
# SIM_PLACE_ID=122385531796312
